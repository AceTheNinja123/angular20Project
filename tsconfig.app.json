{
  "extends": "./tsconfig.json",
  "strictTemplates": true,
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "rootDir": "./src",
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@components/*": [
        "./src/app/components/*"
      ],
      "@src/*": [
        "./src/*"
      ],
    },
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.css",
    "src/**/*.less",
    "src/**/*.scss",
    "src/**/*.sass",
    "src/**/*.html",
    "src/**/*.json"
  ],
  "exclude": [
    "src/test.ts",
    "src/**/*.spec.ts"
  ]
}